<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Extend barcode wizard form -->
    <record
        id="view_stock_barcodes_read_picking_delivery_proof_form"
        model="ir.ui.view"
    >
        <field name="name">stock.barcodes.read.picking.delivery.proof.form</field>
        <field name="model">wiz.stock.barcodes.read.picking</field>
        <field
            name="inherit_id"
            ref="stock_barcodes.view_stock_barcodes_read_picking_form"
        />
        <field name="arch" type="xml">

            <!-- Add hidden field for context -->
            <xpath
                expr="//button[@name='action_clean_values']/../field[@name='picking_state']"
                position="after"
            >
                <field name="show_delivery_proof" invisible="1" />
                <field name="delivery_proof_level" invisible="1" />
                <field name="picking_proof_count" invisible="1" />
            </xpath>

            <!-- Add delivery_proof_count field to pending_move_ids kanban -->
            <xpath
                expr="//field[@name='pending_move_ids']//field[@name='picking_state']"
                position="after"
            >
                <field name="delivery_proof_count" />
                <field name="has_delivery_proof" />
            </xpath>

            <!-- Add camera button to pending_move_ids kanban -->
            <xpath
                expr="//field[@name='pending_move_ids']//button[@name='action_barcode_inventory_quant_edit']"
                position="after"
            >
                <!-- Camera button appears after edit button, only when qty_picked > 0 and mode is move_line -->
                <button
                    name="action_open_line_photos_modal"
                    type="object"
                    class="btn mt0 btn-delivery-camera-line ml-2 position-relative"
                    title="Delivery Photos"
                    context="{'wiz_barcode_id': parent.id, 'todo_id': id}"
                    invisible="qty_picked == 0 or not parent.show_delivery_proof or parent.delivery_proof_level == 'picking'"
                >
                    <i class="fa fa-camera fa-2x" title="Delivery Photos" />
                    <span
                        t-if="record.delivery_proof_count.raw_value > 0"
                        class="badge badge-primary position-absolute"
                        style="top: -5px; right: -5px; font-size: 0.8em;"
                        t-esc="record.delivery_proof_count.raw_value"
                    />
                </button>
            </xpath>

            <!-- Add camera button to bottom bar for picking-level mode -->
            <xpath
                expr="//div[hasclass('oe_stock_barcodes_bottombar')]//div[hasclass('dropup')]"
                position="inside"
            >
                <button
                    name="action_open_picking_photos_modal"
                    type="object"
                    title="Delivery Photos (Picking)"
                    icon="fa-camera fa-2x"
                    invisible="not show_delivery_proof or delivery_proof_level != 'picking'"
                    class="btn btn-secondary"
                />
            </xpath>

        </field>
    </record>
</odoo>
