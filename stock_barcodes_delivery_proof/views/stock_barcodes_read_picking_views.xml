<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Extend barcode wizard form -->
    <record
        id="view_stock_barcodes_read_picking_delivery_proof_form"
        model="ir.ui.view"
    >
        <field name="name">stock.barcodes.read.picking.delivery.proof.form</field>
        <field name="model">wiz.stock.barcodes.read.picking</field>
        <field
            name="inherit_id"
            ref="stock_barcodes.view_stock_barcodes_read_picking_form"
        />
        <field name="arch" type="xml">
            <!-- Add invisible fields for context in the main form bottom bar -->
            <xpath
                expr="//button[@name='action_clean_values']/../field[@name='picking_state']"
                position="after"
            >
                <field name="show_delivery_proof" invisible="1" />
                <field name="delivery_proof_count" invisible="1" />
                <field name="delivery_proof_level" invisible="1" />
            </xpath>

            <!-- Note: Camera capture button is integrated in the delivery_proof widget below -->
            <!-- The widget automatically displays a "Capture Photo" button when enabled -->

            <!-- Add delivery proof gallery section before pending moves -->
            <xpath expr="//field[@name='pending_move_ids']/.." position="before">
                <div
                    class="delivery-proof-gallery-section bg-light p-3 mb-3"
                    invisible="not show_delivery_proof"
                >
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="mb-0">
                            <i class="fa fa-camera text-info" /> Delivery Photos
                        </h5>
                        <field
                            name="delivery_proof_count"
                            invisible="delivery_proof_count == 0"
                            class="badge bg-info"
                            readonly="1"
                            nolabel="1"
                            string="photos"
                        />
                    </div>

                    <!-- Use custom widget for delivery proof -->
                    <field
                        name="delivery_proof_ids"
                        widget="delivery_proof"
                        nolabel="1"
                        options="{'no_create': True, 'no_edit': True}"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
