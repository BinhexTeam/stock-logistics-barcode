<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.delivery.proof</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='signature_delivery_orders']" position="after">
                <setting
                    id="delivery_proof_enabled_setting"
                    help="Enable photo capture as proof of delivery from the barcode scanner interface"
                    documentation="/stock_barcodes_delivery_proof/readme/CONFIGURE.html"
                >
                    <field name="delivery_proof_enabled" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
