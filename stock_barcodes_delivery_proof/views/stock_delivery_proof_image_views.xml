<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Kanban view for delivery proof images -->
    <record id="view_stock_delivery_proof_image_kanban" model="ir.ui.view">
        <field name="name">stock.delivery.proof.image.kanban</field>
        <field name="model">stock.delivery.proof.image</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id" />
                <field name="image" />
                <field name="capture_date" />
                <field name="captured_by_id" />
                <field name="move_line_id" />
                <field name="notes" />
                <templates>
                    <t t-name="kanban-box">
                        <div
                            class="oe_kanban_global_click o_kanban_record_has_image_fill"
                        >
                            <!-- Image -->
                            <div class="o_kanban_image">
                                <img
                                    t-att-src="kanban_image('stock.delivery.proof.image', 'image', record.id.raw_value)"
                                    alt="Delivery proof"
                                    class="o_image_128_max"
                                />
                            </div>

                            <!-- Details -->
                            <div class="oe_kanban_details">
                                <!-- Capture date -->
                                <div class="o_kanban_record_title">
                                    <strong>
                                        <i
                                            class="fa fa-calendar"
                                            title="Capture date"
                                        />
                                        <field name="capture_date" widget="datetime" />
                                    </strong>
                                </div>

                                <!-- Captured by -->
                                <div class="o_kanban_record_subtitle">
                                    <i class="fa fa-user" title="Captured by" />
                                    <field name="captured_by_id" />
                                </div>

                                <!-- Move line info -->
                                <div class="o_kanban_record_subtitle text-muted">
                                    <i class="fa fa-barcode" title="Move line" />
                                    <field name="move_line_id" />
                                </div>

                                <!-- Notes (if any) -->
                                <div
                                    t-if="record.notes.raw_value"
                                    class="mt-2 text-muted small"
                                >
                                    <i class="fa fa-comment" title="Notes" />
                                    <field name="notes" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tree view for delivery proof images -->
    <record id="view_stock_delivery_proof_image_tree" model="ir.ui.view">
        <field name="name">stock.delivery.proof.image.tree</field>
        <field name="model">stock.delivery.proof.image</field>
        <field name="arch" type="xml">
            <tree>
                <field name="image" widget="image" options="{'size': [64, 64]}" />
                <field name="capture_date" />
                <field name="captured_by_id" />
                <field name="move_line_id" />
                <field name="notes" optional="hide" />
            </tree>
        </field>
    </record>

    <!-- Form view for delivery proof images -->
    <record id="view_stock_delivery_proof_image_form" model="ir.ui.view">
        <field name="name">stock.delivery.proof.image.form</field>
        <field name="model">stock.delivery.proof.image</field>
        <field name="arch" type="xml">
            <form string="Delivery Proof Photo">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="capture_date" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="move_line_id" readonly="1" />
                            <field name="captured_by_id" readonly="1" />
                        </group>
                        <group>
                            <field
                                name="image"
                                widget="image"
                                class="oe_avatar"
                                options="{'size': [256, 256]}"
                            />
                        </group>
                    </group>
                    <group>
                        <field
                            name="notes"
                            placeholder="Add notes about this photo..."
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view for delivery proof images -->
    <record id="view_stock_delivery_proof_image_search" model="ir.ui.view">
        <field name="name">stock.delivery.proof.image.search</field>
        <field name="model">stock.delivery.proof.image</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_line_id" />
                <field name="captured_by_id" />
                <field name="capture_date" />
                <filter
                    string="Today"
                    name="today"
                    domain="[('capture_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('capture_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"
                />
                <filter
                    string="This Week"
                    name="this_week"
                    domain="[('capture_date', '&gt;=', (context_today() - relativedelta(weeks=1)).strftime('%Y-%m-%d'))]"
                />
                <group expand="1" string="Group By">
                    <filter
                        string="Capture Date"
                        name="capture_date"
                        context="{'group_by':'capture_date:day'}"
                    />
                    <filter
                        string="Captured By"
                        name="captured_by"
                        context="{'group_by':'captured_by_id'}"
                    />
                    <filter
                        string="Move Line"
                        name="move_line"
                        context="{'group_by':'move_line_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action stock.delivery.proof.image -->
    <record id="action_stock_delivery_proof_image" model="ir.actions.act_window">
        <field name="name">Delivery Proof Photos</field>
        <field name="res_model">stock.delivery.proof.image</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No delivery proof photos yet
            </p>
            <p>
                Delivery proof photos are captured during the barcode scanning process
                for outgoing deliveries.
            </p>
        </field>
    </record>

</odoo>
