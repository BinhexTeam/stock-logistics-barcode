<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_barcodes_read_inventory_form" model="ir.ui.view">
        <field name="name">stock.barcodes.read.inventory.form</field>
        <field name="model">wiz.stock.barcodes.read.inventory</field>
        <field name="inherit_id" eval="False" />
        <field name="arch" type="xml">
            <form
                string="Count"
                class="o_stock_barcode_simple"
                js_class="stock_barcodes_form"
            >
                <field name="_barcode_scanned" widget="barcode_handler" invisible="0" />
                <field name="barcode" invisible="1" />
                <field name="product_tracking" invisible="1" />
                <field name="display_menu" invisible="1" />
                <field name="location_id" invisible="1" />
                <field name="instruction_text" invisible="1" />
                <field name="show_to_count" invisible="1" />
                <field name="show_counted" invisible="1" />
                <div class="p-3 d-flex flex-column gap-3">
                    <div
                        class="navbar bg-light shadow-sm rounded px-3 py-2 mb-1 align-items-center"
                    >
                        <button
                            type="object"
                            name="open_actions"
                            class="barcode-btn me-3"
                            title="Back to menu"
                        >
                            <i class="fa fa-chevron-left" />
                        </button>
                        <div class="h5 mb-0 flex-grow-1">Inventory</div>
                        <a
                            href="#"
                            class="barcode-btn barcode-btn-light o_stock_barcodes_camera_btn ms-2"
                            role="button"
                            title="Scan with camera"
                            aria-label="Scan with camera"
                        >
                            <i class="fa fa-camera" />
                        </a>
                        <button
                            type="object"
                            name="action_cycle_multiplier"
                            class="barcode-btn ms-2"
                            title="Cycle multiplier"
                        >
                            <field name="multiplier_factor" readonly="1" class="mb-0" />
                        </button>
                    </div>

                    <div class="card shadow-sm">
                        <div
                            class="card-body py-2 d-flex justify-content-between align-items-center"
                        >
                            <div class="flex-grow-1">
                                <div
                                    class="text-muted text-uppercase small"
                                >Location</div>
                                <field
                                    name="location_id"
                                    readonly="1"
                                    options="{'no_create': True, 'no_open': True}"
                                    nolabel="1"
                                    class="h6 mb-0"
                                />
                            </div>
                            <button
                                type="object"
                                name="action_change_location_filter"
                                context="{'clear_location': True}"
                                class="btn barcode-btn btn-secondary barcode-btn-light btn-square-rounded"
                                title="Clear context"
                            >
                                <i class="fa fa-map-marker" />
                            </button>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-1">
                        <div class="card-body py-2 d-flex align-items-center gap-2">
                            <div class="flex-grow-1">
                                <div
                                    class="text-muted text-uppercase small mb-1"
                                >Instructions</div>
                                <field
                                    name="instruction_text"
                                    readonly="1"
                                    nolabel="1"
                                    class="h6 mb-0"
                                />
                            </div>
                            <button
                                type="object"
                                name="action_clear_context"
                                class="btn barcode-btn btn-secondary barcode-btn-light btn-square-rounded"
                                title="Clear product/lot"
                            >
                                <i class="fa fa-undo" />
                            </button>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <div class="h6 m-0">Counted</div>
                        <button
                            name="action_toggle_counted"
                            type="object"
                            class="btn barcode-btn btn-secondary barcode-btn-light btn-square-rounded"
                            title="Toggle counted"
                        >
                            <i class="fa fa-chevron-down" invisible="show_counted" />
                            <i class="fa fa-chevron-up" invisible="not show_counted" />
                        </button>
                    </div>
                    <group invisible="not show_counted">
                        <field
                            name="inventory_quant_ids_counted"
                            readonly="1"
                            nolabel="1"
                            options="{'no_open': True}"
                            mode="kanban"
                        >
                            <kanban
                                class="o_kanban_mobile"
                                js_class="stock_barcodes_kanban"
                            >
                                <field name="product_id" />
                                <field name="lot_id" />
                                <field name="quantity" />
                                <field name="inventory_quantity" />
                                <field name="inventory_diff_quantity" />
                                <templates>
                                    <t t-name="kanban-box">
                                        <div
                                            class="oe_kanban_content o_barcode_noopen p-3 shadow-sm rounded bg-white d-flex align-items-start"
                                        >
                                            <div class="flex-grow-1">
                                                <div class="fw-bold h6 mb-1">
                                                    <field name="product_id" />
                                                </div>
                                                <t t-if="record.lot_id.raw_value">
                                                    <div
                                                        class="text-muted small"
                                                    >Lot/Serial: <field
                                                        name="lot_id"
                                                    /></div>
                                                </t>
                                                <div
                                                    class="mt-2 small text-muted d-flex flex-column gap-1"
                                                >
                                                    <span>On hand: <field
                                                        name="quantity"
                                                    /></span>
                                                    <span>Counted: <field
                                                        name="inventory_quantity"
                                                    /></span>
                                                    <span
                                                        t-att-class="record.inventory_diff_quantity.raw_value &lt; 0 ? 'fw-bold text-danger' : (record.inventory_diff_quantity.raw_value &gt; 0 ? 'fw-bold text-success' : 'fw-bold text-dark')"
                                                    >Diff: <field name="inventory_diff_quantity" /></span>
                                                </div>
                                            </div>
                                            <div
                                                class="ms-2 d-flex flex-column gap-2 align-items-end"
                                            >
                                                <div class="btn-group" role="group">
                                                    <button
                                                        name="operation_quantities_rest"
                                                        type="object"
                                                        class="barcode-btn barcode-btn-light"
                                                        title="Decrease"
                                                        context="{'wiz_barcode_id': parent.id}"
                                                    >
                                                        <i class="fa fa-minus" />
                                                    </button>
                                                    <button
                                                        name="operation_quantities"
                                                        type="object"
                                                        class="barcode-btn barcode-btn-light"
                                                        title="Increase"
                                                        context="{'wiz_barcode_id': parent.id}"
                                                    >
                                                        <i class="fa fa-plus" />
                                                    </button>
                                                </div>
                                                <div class="d-flex gap-1">
                                                    <button
                                                        name="action_barcode_inventory_quant_unlink"
                                                        type="object"
                                                        class="barcode-btn barcode-btn-light"
                                                        title="Reset"
                                                        context="{'wiz_barcode_id': parent.id}"
                                                    >
                                                        <i class="fa fa-undo" />
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </group>

                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <div class="h6 m-0">To Count</div>
                        <button
                            name="action_toggle_to_count"
                            type="object"
                            class="btn barcode-btn btn-secondary barcode-btn-light btn-square-rounded"
                            title="Toggle to count"
                        >
                            <i class="fa fa-chevron-down" invisible="show_to_count" />
                            <i class="fa fa-chevron-up" invisible="not show_to_count" />
                        </button>
                    </div>
                    <group invisible="not show_to_count">
                        <field
                            name="inventory_quant_ids_to_count"
                            readonly="1"
                            nolabel="1"
                            options="{'no_open': True}"
                            mode="kanban"
                        >
                            <kanban
                                class="o_kanban_mobile"
                                js_class="stock_barcodes_kanban"
                            >
                                <field name="product_id" />
                                <field name="lot_id" />
                                <field name="quantity" />
                                <field name="inventory_quantity" />
                                <field name="inventory_diff_quantity" />
                                <templates>
                                    <t t-name="kanban-box">
                                        <div
                                            class="oe_kanban_content o_barcode_noopen p-3 shadow-sm rounded bg-white d-flex align-items-start"
                                        >
                                            <div class="flex-grow-1">
                                                <div class="fw-bold h6 mb-1">
                                                    <field name="product_id" />
                                                </div>
                                                <t t-if="record.lot_id.raw_value">
                                                    <div
                                                        class="text-muted small"
                                                    >Lot/Serial: <field
                                                        name="lot_id"
                                                    /></div>
                                                </t>
                                                <div
                                                    class="mt-2 small text-muted d-flex flex-column gap-1"
                                                >
                                                    <span>On hand: <field
                                                        name="quantity"
                                                    /></span>
                                                    <span>Counted: <field
                                                        name="inventory_quantity"
                                                    /></span>
                                                    <span
                                                        t-att-class="record.inventory_diff_quantity.raw_value &lt; 0 ? 'fw-bold text-danger' : (record.inventory_diff_quantity.raw_value &gt; 0 ? 'fw-bold text-success' : 'fw-bold text-dark')"
                                                    >Diff: <field name="inventory_diff_quantity" /></span>
                                                </div>
                                            </div>
                                            <div
                                                class="ms-2 d-flex flex-column gap-2 align-items-end"
                                            >
                                                <div class="btn-group" role="group">
                                                    <button
                                                        name="operation_quantities_rest"
                                                        type="object"
                                                        class="barcode-btn barcode-btn-light"
                                                        title="Decrease"
                                                        context="{'wiz_barcode_id': parent.id}"
                                                    >
                                                        <i class="fa fa-minus" />
                                                    </button>
                                                    <button
                                                        name="operation_quantities"
                                                        type="object"
                                                        class="barcode-btn barcode-btn-light"
                                                        title="Increase"
                                                        context="{'wiz_barcode_id': parent.id}"
                                                    >
                                                        <i class="fa fa-plus" />
                                                    </button>
                                                </div>
                                                <div class="d-flex gap-1">
                                                    <button
                                                        name="action_barcode_inventory_quant_unlink"
                                                        type="object"
                                                        class="barcode-btn barcode-btn-light"
                                                        title="Reset"
                                                        context="{'wiz_barcode_id': parent.id}"
                                                    >
                                                        <i class="fa fa-undo" />
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </group>

                    <div class="d-flex justify-content-end mt-3">
                        <button
                            name="action_manual_entry"
                            type="object"
                            class="btn btn-primary btn-lg w-100 mt-2 py-3"
                            title="Add product"
                            aria-label="Add product"
                        >
                            <i class="fa fa-plus" />
                        </button>
                    </div>

                    <button
                        name="apply_inventory"
                        type="object"
                        class="btn btn-primary btn-lg w-100 mt-2 py-3"
                        title="Apply counts"
                        string="Apply All"
                        invisible="not inventory_quant_ids"
                        groups="stock.group_stock_manager"
                    />
                </div>
            </form>
        </field>
    </record>
    <!--
     Open wizard in current target option to avoid that the wizard is
     closed after any button click,
    -->
    <record id="action_stock_barcodes_read_inventory" model="ir.actions.act_window">
        <field name="res_model">wiz.stock.barcodes.read.inventory</field>
        <field name="name">Barcodes Read</field>
        <field name="view_mode">form</field>
        <field name="context">{"control_panel_hidden": True,
                               "form_view_initial_mode": "edit",
                               "inventory_mode": True,
                               }
        </field>
        <field name="view_id" ref="view_stock_barcodes_read_inventory_form" />
        <field name="target">fullscreen</field>
    </record>
</odoo>
