<odoo>
    <record id="view_stock_barcodes_read_form" model="ir.ui.view">
        <field name="name">stock.barcodes.read.form</field>
        <field name="model">wiz.stock.barcodes.read</field>
        <field name="arch" type="xml">
            <form
                string="Barcodes"
                class="oe_stock_barcordes_form h-100"
                js_class="stock_barcodes_form"
            >
                <div class="d-flex flex-column h-100" invisible="display_menu">
                    <div name="info" class="text-center h3 mb-2">
                        <div
                            class="alert barcode-info text-white mb-0 d-flex"
                            role="status"
                        >
                            <button
                                name="open_actions"
                                type="object"
                                class="ms-auto oe_kanban_action_button btn-sm"
                                title="Open actions"
                                invisible="display_menu"
                                data-hotkey="0"
                            >
                                <i class="fa fa-chevron-left fa-2x text-white" />
                            </button>
                            <field name="message" class="mt-3 h3 text-white" />
                            <span
                                title="Barcode"
                                class="fa fa-barcode fa-2x mt-2 mx-3"
                            />
                            <a
                                href="#"
                                class="btn btn-light btn-sm ms-auto d-flex align-items-center o_stock_barcodes_camera_btn"
                                role="button"
                                title="Scan with camera"
                                aria-label="Scan with camera"
                                invisible="display_menu"
                            >
                                <i class="fa fa-camera me-1" />
                                <span class="d-none d-md-inline">Scan</span>
                            </a>
                        </div>
                    </div>
                    <div
                        invisible="display_menu"
                        class="flex-fill oe_stock_barcordes_content"
                    >
                        <field name="message_type" invisible="1" />
                        <field name="barcode" invisible="1" force_save="1" />
                        <field name="step" invisible="1" force_save="1" />
                        <field name="is_manual_qty" invisible="1" />
                        <field name="is_manual_confirm" invisible="1" />
                        <field name="auto_lot" invisible="1" />
                        <field name="product_tracking" invisible="1" force_save="1" />
                        <field name="guided_product_id" invisible="1" force_save="1" />
                        <field name="guided_location_id" invisible="1" force_save="1" />
                        <field
                            name="guided_location_dest_id"
                            invisible="1"
                            force_save="1"
                        />
                        <field name="guided_lot_id" invisible="1" force_save="1" />
                        <field name="visible_force_done" invisible="1" force_save="1" />
                        <field name="res_model_id" invisible="1" />
                        <field name="res_id" invisible="1" />
                        <field name="option_group_id" invisible="1" force_save="1" />
                        <field name="confirmed_moves" invisible="1" force_save="1" />
                        <field name="keep_result_package" invisible="1" />
                        <field name="create_lot" invisible="1" />
                        <field name="lot_id" invisible="1" />
                        <!-- Anchor kept for inherited views (inventory, etc.) -->
                        <field name="product_qty" invisible="1" force_save="1" />
                        <field name="show_form_scan" invisible="1" />
                        <field name="show_owner" invisible="1" />
                        <field
                            name="_barcode_scanned"
                            widget="barcode_handler"
                            invisible="0"
                        />
                        <group name="scan_fields" class="bg-light scan_fields p-2">
                            <div class="row g-2 mb-2" name="scan_header_cards">
                                <div class="col-12">
                                    <group
                                        name="location"
                                        col="1"
                                        class="p-0 m-0 border-0"
                                    >
                                        <div
                                            class="card shadow-sm border-0"
                                            name="location_card"
                                        >
                                            <div class="card-body py-2 px-3">
                                                <div
                                                    class="text-muted text-uppercase small mb-1"
                                                >Locations</div>
                                                <div class="d-flex flex-column gap-1">
                                                    <div>
                                                        <span
                                                            class="text-muted small"
                                                        >Source</span>
                                                        <field
                                                            name="location_id"
                                                            options="{'no_create': True, 'no_open': True}"
                                                            readonly="not manual_entry"
                                                            force_save="1"
                                                            nolabel="1"
                                                            class="h6 mb-0"
                                                        />
                                                    </div>
                                                    <div>
                                                        <span
                                                            class="text-muted small"
                                                        >Destination</span>
                                                        <field
                                                            name="guided_location_dest_id"
                                                            options="{'no_create': True, 'no_open': True}"
                                                            readonly="1"
                                                            force_save="1"
                                                            nolabel="1"
                                                            class="h6 mb-0"
                                                            invisible="not guided_location_dest_id"
                                                        />
                                                        <field
                                                            name="location_dest_id"
                                                            options="{'no_create': True, 'no_open': True}"
                                                            readonly="1"
                                                            force_save="1"
                                                            nolabel="1"
                                                            class="h6 mb-0"
                                                            invisible="guided_location_dest_id"
                                                        />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </group>
                                </div>
                                <div class="col-12">
                                    <div
                                        class="card shadow-sm border-0 h-100"
                                        name="product_card"
                                    >
                                        <div class="card-body py-2 px-3">
                                            <div class="d-flex align-items-start gap-2">
                                                <div class="flex-fill">
                                                    <field
                                                        name="product_id"
                                                        options="{'no_create': True, 'no_open': True}"
                                                        readonly="not manual_entry"
                                                        force_save="1"
                                                        nolabel="1"
                                                        class="h5 mb-1"
                                                    />
                                                    <div invisible="product_id">
                                                        <span
                                                            class="text-muted small"
                                                        >Scan or select a product</span>
                                                    </div>
                                                </div>
                                                <div
                                                    class="d-flex align-items-center"
                                                    invisible="product_id == False"
                                                >
                                                    <button
                                                        class="btn btn-warning btn-sm oe_kanban_action_button"
                                                        name="action_clean_product"
                                                        type="object"
                                                        icon="fa-trash fa-1x"
                                                        title="Clean product"
                                                    />
                                                </div>
                                            </div>
                                            <div
                                                class="mt-2"
                                                invisible="not product_id or not show_owner"
                                            >
                                                <span
                                                    class="text-muted small"
                                                >Owner</span>
                                                <field
                                                    name="owner_id"
                                                    options="{'no_create': True, 'no_open': True}"
                                                    force_save="1"
                                                    nolabel="1"
                                                    class="h6"
                                                />
                                            </div>
                                            <div
                                                class="d-flex align-items-start gap-2 mt-2"
                                                groups="stock.group_production_lot"
                                                invisible="product_tracking in ('none', False)"
                                            >
                                                <div class="flex-fill">
                                                    <span
                                                        class="text-muted small"
                                                    >Lot / Serial</span>
                                                    <field
                                                        name="lot_name"
                                                        invisible="not create_lot"
                                                        nolabel="1"
                                                        class="h6"
                                                    />
                                                    <field
                                                        name="lot_id"
                                                        options="{'no_create': True, 'no_open': True}"
                                                        domain="[('product_id', '=', product_id)]"
                                                        context="{'default_product_id': product_id}"
                                                        readonly="not manual_entry"
                                                        invisible="create_lot"
                                                        force_save="1"
                                                        nolabel="1"
                                                        class="h6"
                                                    />
                                                    <div invisible="product_id">
                                                        <span
                                                            class="text-muted small"
                                                        >Awaiting lot/serial</span>
                                                    </div>
                                                </div>
                                                <div
                                                    class="d-flex align-items-center gap-1"
                                                >
                                                    <button
                                                        class="btn btn-warning btn-sm oe_kanban_action_button"
                                                        name="action_clean_lot"
                                                        type="object"
                                                        icon="fa-trash fa-1x"
                                                        invisible="lot_id == False and lot_name == False"
                                                        title="Clean lot"
                                                        data-hotkey="G"
                                                    />
                                                    <button
                                                        id="btn_create_lot"
                                                        class="btn btn-secondary btn-sm oe_kanban_action_button border"
                                                        type="action"
                                                        name="%(action_stock_barcodes_new_lot)d"
                                                        icon="fa-plus fa-1x"
                                                        title="Create lot"
                                                        context="{'default_product_id': product_id}"
                                                        invisible="not create_lot"
                                                        help="Create new lot"
                                                    />
                                                </div>
                                            </div>
                                            <div
                                                class="mt-2"
                                                invisible="not lot_id and not lot_name"
                                            >
                                                <span
                                                    class="text-muted small"
                                                >Current lot/serial</span>
                                                <field
                                                    name="lot_id"
                                                    options="{'no_create': True, 'no_open': True}"
                                                    readonly="1"
                                                    nolabel="1"
                                                    class="h6"
                                                    invisible="not lot_id"
                                                />
                                                <field
                                                    name="lot_name"
                                                    readonly="1"
                                                    nolabel="1"
                                                    class="h6"
                                                    invisible="lot_id or not lot_name"
                                                />
                                            </div>
                                            <!-- Quantity removed from product card; handled at line level -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Quantity now handled inside product card; keep anchors hidden for inheritance safety -->
                            <group name="option_qty_info" invisible="1" />
                            <group name="option_qty" invisible="1" />
                        </group>
                    </div>
                    <div
                        class="oe_stock_barcodes_bottombar d-flex"
                        invisible="display_menu or not enable_add_product"
                    >
                        <field name="display_menu" invisible="1" />
                        <field name="enable_add_product" invisible="1" />
                        <field
                            name="manual_entry"
                            widget="barcode_boolean_toggle"
                            class="d-none"
                        />
                        <div class="btn-group dropup" invisible="display_menu" />

                        <!-- HACK: To avoid inheritance crash -->
                        <button name="action_manual_entry" invisible="1" />
                        <!-- Hide button in view to allow do onclick in JS. Use d-none instead of
                             invisible attribute to be allocated by jquery selector
                         -->
                        <button
                            name="dummy_on_barcode_scanned"
                            id="dummy_on_barcode_scanned"
                            type="object"
                            data-hotkey="99"
                            invisible="0"
                            class="d-none"
                        />

                        <button
                            name="action_confirm"
                            type="object"
                            icon="fa-check"
                            title="Confirm"
                            class="btn-success w-100 oe_kanban_action_button btn-sm ps-3 pe-3  text-uppercase d-flex justify-content-center align-items-center fs-2"
                            invisible="((not is_manual_confirm and not manual_entry) or display_menu) or visible_force_done"
                            data-hotkey="8"
                        >
                            <span class="d-none d-lg-block">Validate</span>
                        </button>
                        <button
                            name="action_add_scan_manual"
                            type="object"
                            title="ADD PRODUCT"
                            icon="fa-plus"
                            class="btn-secondary w-100 oe_kanban_action_button btn-sm text-uppercase
                            d-flex justify-content-center align-items-center fs-2 d-none"
                            invisible="1"
                            style="width: 50px"
                            data-hotkey="8"
                        >
                            <span class="d-none d-lg-block">Product</span>
                        </button>
                        <button
                            name="action_clean_values"
                            type="object"
                            icon="fa-trash-o"
                            title="Clean Values"
                            class="btn-warning w-100 oe_kanban_action_button btn-sm ps-3 pe-3 mx-1
                                        text-uppercase d-flex justify-content-center align-items-center fs-2"
                            invisible="display_menu or not manual_entry"
                            data-hotkey="7"
                        >
                            <span class="d-none d-lg-block">Clean Values</span>
                        </button>
                        <button
                            name="action_force_done"
                            type="object"
                            icon="fa-check"
                            title="Force done"
                            invisible="not visible_force_done"
                            class="btn-danger w-100 oe_kanban_action_button btn-sm ps-3 pe-3 text-uppercase d-flex justify-content-center align-items-center"
                            style="width: 50px"
                            data-hotkey="8"
                        >
                            <span class="d-none d-lg-block">Confirm</span>
                        </button>
                    </div>
                </div>
            </form>
        </field>
    </record>
    <!--
     Open wizard in current target option to avoid that the wizard is
     closed after any button click,
    -->
    <record id="action_stock_barcodes_read" model="ir.actions.act_window">
        <field name="res_model">wiz.stock.barcodes.read</field>
        <field name="name">Barcodes Read</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="view_id" ref="view_stock_barcodes_read_form" />
        <field name="target">fullscreen</field>
    </record>
    <record id="view_stock_barcodes_read_form_manual_qty" model="ir.ui.view">
        <field name="name">stock.barcodes.read.form.manual_qty</field>
        <field name="model">wiz.stock.barcodes.read</field>
        <field name="priority" eval="999" />
        <field name="arch" type="xml">
            <form string="Barcodes manual quantities">
                <sheet>
                    <field
                        name="product_qty"
                        force_save="1"
                        nolabel="1"
                        widget="numeric_step"
                        options="{'auto_select': True}"
                    />
                    <button
                        name="action_reopen_wizard"
                        type="object"
                        icon="fa-check"
                        title="Reopen"
                        class="btn-success"
                    />
                </sheet>
            </form>
        </field>
    </record>
</odoo>
