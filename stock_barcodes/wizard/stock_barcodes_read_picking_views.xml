<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_line_minimal_tree" model="ir.ui.view">
        <field name="name">stock.move.line.tree.minimal.barcode</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <list string="Detailed Operations" create="0" edit="0" delete="0">
                <field name="product_id" string="Product" />
                <field name="lot_id" string="Lot/Serial" options="{'no_open': True}" />
                <field name="lot_name" string="Lot/Serial" invisible="lot_id" />
                <field name="quantity" string="Qty" />
            </list>
        </field>
    </record>

    <record id="view_move_line_minimal_kanban" model="ir.ui.view">
        <field name="name">stock.move.line.kanban.minimal.barcode</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="product_id" />
                <field name="product_tracking" invisible="1" />
                <field name="product_type" invisible="1" />
                <field name="lot_id" />
                <field name="lot_name" />
                <field name="quantity" />
                <templates>
                    <t t-name="kanban-box">
                        <div
                            class="oe_kanban_content p-2 d-flex align-items-start o_barcode_noopen"
                        >
                            <div class="flex-grow-1">
                                <div class="fw-bold">
                                    <field name="product_id" />
                                </div>
                                <t t-if="record.lot_id or record.lot_name">
                                    <div class="text-muted small">
                                        <t
                                            t-esc="record.lot_id.value or record.lot_name.value"
                                        />
                                    </div>
                                </t>
                                <div class="mt-1">
                                    <span class="fw-bold">
                                        <t t-esc="record.quantity.value" />
                                    </span>
                                </div>
                            </div>
                            <div class="ms-2 d-flex gap-1 align-items-start">
                                <button
                                    name="action_barcode_decrement_line"
                                    type="object"
                                    class="barcode-btn barcode-btn-light"
                                    title="Remove qty"
                                >
                                    <i class="fa fa-minus" />
                                </button>
                                <button
                                    name="action_barcode_increment_line"
                                    type="object"
                                    class="barcode-btn barcode-btn-light"
                                    title="Add qty"
                                >
                                    <i class="fa fa-plus" />
                                </button>
                                <button
                                    name="action_barcode_change_lot"
                                    type="object"
                                    class="barcode-btn barcode-btn-light"
                                    t-att-title="'Change lot/serial'"
                                    t-if="record.product_tracking.raw_value == 'lot' or record.product_tracking.raw_value == 'serial'"
                                >
                                    <i class="fa fa-tags" />
                                </button>
                                <button
                                    name="action_barcode_detailed_operation_unlink"
                                    type="object"
                                    class="barcode-btn barcode-btn-light"
                                    title="Remove line"
                                >
                                    <i class="fa fa-trash" />
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_stock_barcodes_read_picking_form" model="ir.ui.view">
        <field name="name">stock.barcodes.read.picking.form</field>
        <field name="model">wiz.stock.barcodes.read.picking</field>
        <field name="inherit_id" eval="False" />
        <field name="arch" type="xml">
            <form
                string="Scan"
                class="o_stock_barcode_simple oe_stock_barcordes_form"
                js_class="stock_barcodes_form"
            >
                <field name="_barcode_scanned" widget="barcode_handler" invisible="0" />
                <field name="barcode" invisible="1" />
                <field name="picking_id" invisible="1" />
                <field name="picking_type_code" invisible="1" />
                <field name="product_tracking" invisible="1" />
                <field name="show_source_location" invisible="1" />
                <field name="show_destination_location" invisible="1" />
                <field name="show_todo_list" invisible="1" />
                <field name="show_partner_card" invisible="1" />
                <field name="partner_id" invisible="1" />
                <div class="p-3 d-flex flex-column gap-3">
                    <div
                        class="navbar bg-light shadow-sm rounded px-3 py-2 mb-1 align-items-center"
                    >
                        <button
                            type="object"
                            name="open_actions"
                            class="barcode-btn me-3"
                            title="Back to menu"
                        >
                            <i class="fa fa-chevron-left" />
                        </button>
                        <field
                            name="picking_id"
                            nolabel="1"
                            readonly="1"
                            class="h5 mb-0 flex-grow-1"
                        />
                        <a
                            href="#"
                            class="barcode-btn barcode-btn-light o_stock_barcodes_camera_btn ms-2"
                            role="button"
                            title="Scan with camera"
                            aria-label="Scan with camera"
                        >
                            <i class="fa fa-camera" />
                        </a>
                        <button
                            type="object"
                            name="action_cycle_multiplier"
                            class="barcode-btn ms-2"
                            title="Cycle multiplier"
                        >
                            <field name="multiplier_factor" readonly="1" class="mb-0"/>
                        </button>
                    </div>

                    <div class="card shadow-sm" invisible="not show_partner_card">
                        <div class="card-body py-2">
                            <div class="text-muted text-uppercase small mb-1">Partner</div>
                            <field
                                name="partner_id"
                                readonly="1"
                                nolabel="1"
                                class="h6 mb-0"
                                options="{'no_open': True, 'no_create': True}"
                            />
                        </div>
                    </div>

                    <div class="card shadow-none">
                        <div class="card-body py-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="text-muted text-uppercase small">Locations</div>
                                <div class="d-flex gap-2">
                                    <button
                                        name="action_open_source_location_picker"
                                        type="object"
                                        class="barcode-btn barcode-btn-light"
                                        title="Change source location"
                                        invisible="not show_source_location"
                                    >
                                        <i class="fa fa-map-marker"/>
                                    </button>
                                    <button
                                        name="action_open_destination_location_picker"
                                        type="object"
                                        class="barcode-btn barcode-btn-light"
                                        title="Change destination location"
                                        invisible="not show_destination_location"
                                    >
                                        <i class="fa fa-flag-checkered"/>
                                    </button>
                                </div>
                            </div>
                            <div class="d-flex flex-column flex-md-row gap-2">
                                <div class="flex-fill" invisible="not show_source_location">
                                    <div class="small text-muted">Source</div>
                                    <field
                                            name="location_id"
                                            options="{'no_create': True, 'no_open': True}"
                                            readonly="1"
                                            nolabel="1"
                                            class="mb-0 small fw-semibold"
                                            invisible="not show_source_location"
                                        />
                                </div>
                                <div class="flex-fill" invisible="not show_destination_location">
                                    <div class="small text-muted">Destination</div>
                                    <field
                                            name="location_dest_id"
                                            options="{'no_create': True, 'no_open': True}"
                                            readonly="1"
                                            nolabel="1"
                                            class="mb-0 small fw-semibold"
                                            invisible="not show_destination_location"
                                        />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card shadow-sm mb-3">
                        <div class="card-body py-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="text-muted text-uppercase small">Instructions</div>
                                <button
                                    name="action_clear_context"
                                    type="object"
                                    class="barcode-btn barcode-btn-light"
                                    title="Clear product/lot context"
                                >
                                    <i class="fa fa-undo"/>
                                </button>
                            </div>
                            <field name="instruction_text" readonly="1" nolabel="1" class="h6 mb-0"/>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <div class="h6 m-0">To Do</div>
                        <button
                            name="action_toggle_todo_list"
                            type="object"
                            class="btn barcode-btn btn-secondary barcode-btn-light btn-square-rounded"
                            title="Toggle to do"
                        >
                            <i class="fa fa-chevron-down" invisible="show_todo_list"/>
                            <i class="fa fa-chevron-up" invisible="not show_todo_list"/>
                        </button>
                    </div>
                    <group invisible="not show_todo_list">
                        <field
                            name="todo_line_ids"
                            readonly="1"
                            nolabel="1"
                            options="{'no_open': True}"
                            views="[(list, 'stock_barcodes.view_stock_barcodes_todo_tree'), (kanban, 'stock_barcodes.view_stock_barcodes_todo_kanban')]"
                        />
                    </group>

                    <div class="d-flex justify-content-between align-items-center">
                        <div class="h6 m-0">Detailed Moves</div>
                        <button
                            name="action_show_detailed_operations"
                            type="object"
                            class="btn barcode-btn btn-secondary barcode-btn-light btn-square-rounded"
                            invisible="not move_line_ids"
                            title="Toggle details"
                        >
                            <i class="fa fa-chevron-down" invisible="show_detailed_operations"/>
                            <i class="fa fa-chevron-up" invisible="not show_detailed_operations"/>
                        </button>
                    </div>

                    <group invisible="not show_detailed_operations">
                        <field
                            name="move_line_ids"
                            readonly="1"
                            nolabel="1"
                            options="{'no_open': True}"
                            mode="kanban,list"
                            views="[(list, 'stock_barcodes.view_move_line_minimal_tree'), (kanban, 'stock_barcodes.view_move_line_minimal_kanban')]"
                            context="{
                                'kanban_view_ref': 'stock_barcodes.view_move_line_minimal_kanban',
                                'list_view_ref': 'stock_barcodes.view_move_line_minimal_tree',
                                'tree_view_ref': 'stock_barcodes.view_move_line_minimal_tree',
                                'wiz_barcode_id': id
                            }"
                        />
                    </group>

                    <button
                        name="dummy_on_barcode_scanned"
                        type="object"
                        class="d-none"
                    />

                    <button
                        name="action_validate_picking"
                        type="object"
                        class="btn btn-primary btn-lg w-100 mt-2 py-3"
                        invisible="picking_state not in ('draft', 'assigned', 'confirmed')"
                        title="Validate"
                    >
                        Validate
                    </button>

                    <div class="card shadow-sm mt-2">
                        <div class="card-body">
                            <div class="text-muted text-uppercase small mb-2">Post a message</div>
                            <field name="chatter_message" placeholder="Add a note to the chatter" nolabel="1"/>
                            <field
                                name="attachment_ids"
                                widget="many2many_binary"
                                class="mt-2"
                                context="{'default_res_model': 'stock.picking', 'default_res_id': picking_id}"
                                options="{'no_open': True}"
                            />
                            <button
                                name="action_post_chatter_message"
                                type="object"
                                class="btn btn-secondary w-100 mt-2"
                                string="Post"
                                title="Post to chatter"
                                modifiers="{'readonly': [('chatter_message','=', False)]}"
                            />
                        </div>
                    </div>
                </div>
            </form>
        </field>
    </record>
    <!--
     Open wizard in current target option to avoid that the wizard is
     closed after any button click,
    -->
    <record model="ir.actions.act_window" id="action_stock_barcodes_read_picking">
        <field name="res_model">wiz.stock.barcodes.read.picking</field>
        <field name="name">Barcodes Read</field>
        <field name="view_mode">form</field>
        <field name="context">{"control_panel_hidden": True,
                               "form_view_initial_mode": "edit"}
        </field>
        <field name="view_id" ref="view_stock_barcodes_read_picking_form" />
        <field name="target">fullscreen</field>
    </record>

    <record model="ir.actions.act_window" id="action_stock_barcodes_menu">
        <field name="res_model">wiz.stock.barcodes.read.picking</field>
        <field name="name">Barcodes menu</field>
        <field name="view_mode">form</field>
        <field
            name="context"
        >{'control_panel_hidden': True, "default_display_menu": True}
        </field>
        <field name="view_id" ref="view_stock_barcodes_read_picking_form" />
        <field name="target">current</field>
    </record>
</odoo>
