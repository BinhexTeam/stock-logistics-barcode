<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_barcodes_todo_tree" model="ir.ui.view">
        <field name="name">stock.barcodes.todo.list</field>
        <field name="model">wiz.stock.barcodes.read.todo</field>
        <field name="arch" type="xml">
            <list string="To Do" create="0" edit="0" delete="0">
                <field name="product_id" string="Product" />
                <field name="quantity" string="Picked" />
                <field name="product_uom_qty" string="Expected" />
                <field name="uom_id" string="UoM" />
            </list>
        </field>
    </record>

    <record id="view_stock_barcodes_todo_kanban" model="ir.ui.view">
        <field name="name">stock.barcodes.todo.kanban</field>
        <field name="model">wiz.stock.barcodes.read.todo</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="picking_code" />
                <field name="location_id" />
                <field name="location_name" />
                <field name="location_dest_id" />
                <field name="location_dest_name" />
                <field name="product_id" />
                <field name="quantity" />
                <field name="uom_id" />
                <field name="product_uom_qty" />
                <field name="qty_done" />
                <field name="line_ids" invisible="1" />
                <field name="state" />
                <field name="is_extra_line" />
                <field name="is_focused" />
                <field name="is_stock_move_line_origin" />
                <templates>
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="oe_kanban_content o_barcode_noopen"
                            t-attf-style="background-color: {{ record.is_focused.raw_value and '#e6f0ff' or (record.is_extra_line.raw_value == true and '#ffd683' or '#f0f9fb') }}; border: {{ record.is_focused.raw_value and '1px solid #356ae6' or '1px solid transparent' }};"
                        >
                            <div class="d-flex align-items-start p-2">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-start">
                                        <strong class="me-2">
                                            <field name="product_id" />
                                        </strong>
                                    </div>
                                    <div class="mt-2">
                                        <span class="fw-bold">
                                            <t t-esc="record.quantity.value" />
                                        </span>
                                        <span class="text-muted">/ <t
                                            t-esc="record.product_uom_qty.value"
                                        /> <t
                                            t-esc="record.uom_id.value.slice(0,3)"
                                        /></span>
                                    </div>
                                </div>
                                <div class="ms-2 d-flex gap-1 align-items-start">
                                    <button
                                        name="action_barcode_focus_move"
                                        args="[record.id]"
                                        type="object"
                                        class="barcode-btn barcode-btn-light"
                                        title="Edit"
                                    >
                                        <i class="fa fa-pencil" />
                                    </button>
                                    <button
                                        t-if="(record.product_uom_qty.raw_value - record.quantity.raw_value) > 0"
                                        name="action_barcode_complete_remaining"
                                        type="object"
                                        class="barcode-btn barcode-btn-light"
                                        t-att-title="'+%s' % (record.product_uom_qty.raw_value - record.quantity.raw_value)"
                                    >
                                        <t>+<t t-esc="record.product_uom_qty.raw_value - record.quantity.raw_value" /></t>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
