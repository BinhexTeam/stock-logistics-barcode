<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_barcodes_pick_location_form" model="ir.ui.view">
        <field name="name">wiz.stock.barcodes.pick.location.form</field>
        <field name="model">wiz.stock.barcodes.pick.location</field>
        <field name="arch" type="xml">
            <form string="Select Location" class="o_barcode_noopen">
                <sheet>
                    <group>
                        <field name="target" readonly="1"/>
                        <field name="location_id" domain="[('usage','in', ['internal','transit'])]"/>
                    </group>
                    <footer>
                        <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
